  "scenario": [
    {
      "kind": "paragraph",
      "text": "מסד הנתונים מכיל את טבלת tickets. ראש הצוות מבקש לראות כמה פניות יש בכל רמת עדיפות."
    }
  ],
  "prompt": [
    {
      "kind": "paragraph",
      "text": "כתבי שאילתה שמחזירה את העדיפות (priority) ואת מספר הפניות בה בעמודה בשם ticket_count, ממוינת לפי ticket_count בסדר יורד ואז לפי priority בסדר עולה. במבחן לא יוצג משוב עד לסיום."
    }
  ],
  "sqlSpec": {
    "datasetRef": "DS-SUPPORT",
    "referenceSql": "SELECT priority, COUNT(*) AS ticket_count FROM tickets GROUP BY priority ORDER BY ticket_count DESC, priority ASC",
    "requiredColumns": [
      "priority",
      "ticket_count"
    ],
    "orderMatters": true,
    "requiredTables": [
