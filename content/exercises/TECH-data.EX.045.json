  "scenario": [
    {
      "kind": "paragraph",
      "text": "משתמשת מדווחת שהיא לא רואה את הפניות הישנות שלה. החשד: נוצר לה חשבון שני עם אותה כתובת מייל, וההיסטוריה התפצלה בין שני מזהים. בדיקת ייחודיות היא אחת הבדיקות הראשונות שבודק מריץ על טבלת משתמשים."
    }
  ],
  "prompt": [
    {
      "kind": "paragraph",
      "text": "כתבי שאילתה שמחזירה את כתובת המייל (email) ואת מספר החשבונות שנמצאו לה בעמודה בשם account_count, עבור כתובות שמופיעות ביותר מחשבון אחד. הסדר אינו חשוב."
    }
  ],
  "sqlSpec": {
    "datasetRef": "DS-SUPPORT",
    "referenceSql": "SELECT email, COUNT(*) AS account_count FROM users GROUP BY email HAVING COUNT(*) > 1",
