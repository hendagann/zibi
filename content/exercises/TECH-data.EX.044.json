  "scenario": [
    {
      "kind": "paragraph",
      "text": "מדד זמן הטיפול מחושב מתאריך הסגירה. פנייה שסטטוסה closed אך אין לה תאריך סגירה תיספר כסגורה במונה ותיעלם מחישוב הזמן — כלומר המדד ישתפר מבלי שדבר השתפר. זה סוג התקלה שמנהלים מגלים רק כשמישהו מצליב."
    }
  ],
  "prompt": [
    {
      "kind": "paragraph",
      "text": "כתבי שאילתה שמחזירה את מזהה הפנייה (id), את הנושא (subject) ואת תאריך הפתיחה (created_at) עבור פניות שסטטוסן closed אך closed_at שלהן הוא NULL. הסדר אינו חשוב."
    }
  ],
  "sqlSpec": {
    "datasetRef": "DS-SUPPORT",
    "referenceSql": "SELECT id, subject, created_at FROM tickets WHERE status = 'closed' AND closed_at IS NULL",
