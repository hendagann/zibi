  "scenario": [
    {
      "kind": "paragraph",
      "text": "ראש הצוות רוצה לדעת אם יש נציג שלא שויכה לו אף פנייה — סימן אפשרי לתקלה בשיבוץ האוטומטי. על הנתונים שאת רואה כרגע לכל נציג יש פניות, ולכן התוצאה אמורה להיות ריקה; השאילתה נכתבת כדי לתפוס את המקרה כשהוא יופיע."
    }
  ],
  "prompt": [
    {
      "kind": "paragraph",
      "text": "כתבי שאילתה שמחזירה את שם הנציג (name) ואת הצוות (team) עבור נציגים שלא משויכת אליהם אף פנייה. הסדר אינו חשוב."
    }
  ],
  "sqlSpec": {
    "datasetRef": "DS-SUPPORT",
    "referenceSql": "SELECT agents.name, agents.team FROM agents LEFT JOIN tickets ON tickets.agent_id = agents.id WHERE tickets.id IS NULL",
