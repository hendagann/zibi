  "scenario": [
    {
      "kind": "paragraph",
      "text": "צוות השימור מחפש לקוחות שניסו להזמין אך אף הזמנה שלהם לא הושלמה — לא מי שלא הזמין כלל. ההבחנה הזו היא הלב של השאלה: קבוצה אחת נמצאת בתוך השנייה, וסינון תמים ב-WHERE יחזיר גם לקוחות שיש להם הזמנה שהושלמה לצד אחת שבוטלה."
    }
  ],
  "prompt": [
    {
      "kind": "paragraph",
      "text": "כתבי שאילתה שמחזירה את שם הלקוח (name) ואת מספר ההזמנות שלו בעמודה בשם order_count, עבור לקוחות שיש להם לפחות הזמנה אחת אך אף אחת מהן אינה בסטטוס completed, ממוינת לפי שם בסדר עולה."
    }
  ],
  "sqlSpec": {
    "datasetRef": "DS-SHOP",
    "referenceSql": "SELECT customers.name, COUNT(*) AS order_count FROM orders JOIN customers ON customers.id = orders.customer_id GROUP BY customers.id, customers.name HAVING SUM(CASE WHEN orders.status = 'completed' THEN 1 ELSE 0 END) = 0 ORDER BY customers.name ASC",
    "orderMatters": true,
    "requiredTables": [
      "customers",
      "orders"
