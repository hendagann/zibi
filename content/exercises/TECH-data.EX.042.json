  "scenario": [
    {
      "kind": "paragraph",
      "text": "לפני שיבוץ משמרות, ראש הצוות רוצה לדעת כמה פניות מטופלות בידי כל נציג. שם הנציג יושב בטבלה נפרדת, ולכן צריך לחבר לפני שסופרים."
    }
  ],
  "prompt": [
    {
      "kind": "paragraph",
      "text": "כתבי שאילתה שמחזירה את שם הנציג (name) ואת מספר הפניות המשויכות אליו בעמודה בשם ticket_count, ממוינת לפי ticket_count בסדר יורד ואז לפי שם בסדר עולה."
    }
  ],
  "sqlSpec": {
    "datasetRef": "DS-SUPPORT",
    "referenceSql": "SELECT agents.name, COUNT(*) AS ticket_count FROM tickets JOIN agents ON agents.id = tickets.agent_id GROUP BY agents.id, agents.name ORDER BY ticket_count DESC, agents.name ASC",
    "orderMatters": true,
    "requiredTables": [
      "tickets",
      "agents"
